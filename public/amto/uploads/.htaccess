# [SEC-FIX-03] DP-06, DP-07 & APP-06: Block direct public access and script execution in PII uploads folder.
# All document access must pass through /amto/download.php authorization gatekeeper.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|bat|cmd|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

{{!
    @template core/login_panel
    AMTO Left Panel for Split-Screen Login (Clean SVG Icon, No Emojis)
}}
<div class="amto-left-circle-top"></div>
<div class="amto-left-circle-bottom"></div>

<div class="amto-left-inner">
    <div class="amto-brand-row">
        <div class="amto-brand-badge">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
            </svg>
            <span class="amto-brand-code">AMTO</span>
        </div>
        <div class="amto-brand-titles">
            <div class="amto-brand-lms">LMS</div>
            <div class="amto-brand-sub">Learning &amp; Certification Management System</div>
        </div>
    </div>

    <div class="amto-lang-pill" role="group" aria-label="Language switcher">
        <button type="button" id="amtoBtnEn" class="amto-lang-btn active" onclick="amtoSwitchLoginLang('en')">English</button>
        <button type="button" id="amtoBtnId" class="amto-lang-btn" onclick="amtoSwitchLoginLang('id')">Bahasa</button>
    </div>

    <!-- ENGLISH COPY -->
    <div id="amtoCopyEn">
        <h1 class="amto-welcome-title">Welcome Back!</h1>
        <ul class="amto-welcome-list">
            <li>Access restricted only for authorized Instructor, Assessor, QA, Management, and Trainee of <strong>AMTO (Aircraft Maintenance Training Organization)</strong></li>
            <li>
                Login only using your registered AMTO / SSO Account by following these format:<br>
                <strong>username (Staff/Instructor ID) + @amto.id</strong><br>
                (for Instructor, Assessor, QA &amp; Staff)<br>
                <strong>username (Trainee Reg. ID) + @trainee.amto.id</strong><br>
                (for Trainee / Participant)
            </li>
            <li>If you are experiencing authentication failures, your password may not meet the security requirements (IAM-03). Please update your password or contact AMTO IT Support.</li>
        </ul>
    </div>

    <!-- BAHASA INDONESIA COPY -->
    <div id="amtoCopyId" style="display:none;">
        <h1 class="amto-welcome-title">Selamat Datang!</h1>
        <ul class="amto-welcome-list">
            <li>Akses terbatas hanya untuk Instruktur, <em>Assessor</em>, QA, Manajemen, dan Peserta (<em>Trainee</em>) resmi <strong>AMTO (Aircraft Maintenance Training Organization)</strong></li>
            <li>
                Login hanya menggunakan Akun Resmi AMTO / SSO dengan mengikuti format berikut:<br>
                <strong>username (NIP / ID Staf) + @amto.id</strong><br>
                (untuk Instruktur, Assessor, QA &amp; Staf)<br>
                <strong>username (ID Registrasi) + @trainee.amto.id</strong><br>
                (untuk Peserta / Trainee)
            </li>
            <li>Jika Anda mengalami kegagalan autentikasi, kata sandi Anda mungkin belum memenuhi syarat keamanan (IAM-03). Silakan perbarui kata sandi atau hubungi Admin IT AMTO.</li>
        </ul>
    </div>
</div>

<script>
function amtoSwitchLoginLang(lang) {
    var enBox = document.getElementById('amtoCopyEn');
    var idBox = document.getElementById('amtoCopyId');
    var btnEn = document.getElementById('amtoBtnEn');
    var btnId = document.getElementById('amtoBtnId');
    if (lang === 'id') {
        enBox.style.display = 'none';
        idBox.style.display = 'block';
        btnId.classList.add('active');
        btnEn.classList.remove('active');
    } else {
        enBox.style.display = 'block';
        idBox.style.display = 'none';
        btnEn.classList.add('active');
        btnId.classList.remove('active');
    }
}
</script>

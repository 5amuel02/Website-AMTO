{{!
    @template core/login_panel
    TATC / AMTO Left Panel for Split-Screen Login (Matched to tatcwebreact Red Theme & Official Logos)
}}
<div class="amto-left-circle-top"></div>
<div class="amto-left-circle-bottom"></div>

<div class="amto-left-inner">
    <div class="amto-brand-row">
        <div class="amto-brand-badge">
            <img src="/amto/assets/tatc.png" alt="TATC Logo" style="height: 38px; object-fit: contain;" onerror="this.style.display='none'">
        </div>
        <div class="amto-brand-titles">
            <div class="amto-brand-lms">TATC LMS</div>
            <div class="amto-brand-sub">Aviation Training, Learning &amp; Certification System</div>
        </div>
    </div>

    <div class="amto-lang-pill" role="group" aria-label="Language switcher">
        <button type="button" id="amtoBtnEn" class="amto-lang-btn active" onclick="amtoSwitchLoginLang('en')">English</button>
        <button type="button" id="amtoBtnId" class="amto-lang-btn" onclick="amtoSwitchLoginLang('id')">Bahasa</button>
    </div>

    <!-- ENGLISH COPY -->
    <div id="amtoCopyEn">
        <h1 class="amto-welcome-title">Welcome Back!</h1>
        <ul class="amto-welcome-list">
            <li>Access restricted only for authorized Instructor, Assessor, QA, Management, and Participant of <strong>TATC – AMTO (Aircraft Maintenance Training Organization)</strong></li>
            <li>
                Login using your registered TATC Portal Account by following these format:<br>
                <strong>username / email (@tatc.id)</strong> (for Instructor, Assessor, QA &amp; Staff)<br>
                <strong>participant_number / email</strong> (for Trainee / Participant)
            </li>
            <li>If you are experiencing authentication failures, your password may not meet the security requirements (IAM-03). Please update your password or contact TATC IT Support.</li>
        </ul>
    </div>

    <!-- BAHASA INDONESIA COPY -->
    <div id="amtoCopyId" style="display:none;">
        <h1 class="amto-welcome-title">Selamat Datang!</h1>
        <ul class="amto-welcome-list">
            <li>Akses terbatas hanya untuk Instruktur, <em>Assessor</em>, QA, Manajemen, dan Peserta (<em>Participant/Trainee</em>) resmi <strong>TATC – AMTO</strong></li>
            <li>
                Login menggunakan Akun Portal TATC yang terdaftar dengan format berikut:<br>
                <strong>username / email (@tatc.id)</strong> (untuk Instruktur, Assessor, QA &amp; Staf)<br>
                <strong>nomor peserta / email</strong> (untuk Peserta Pelatihan)
            </li>
            <li>Jika Anda mengalami kegagalan autentikasi, kata sandi Anda mungkin belum memenuhi syarat keamanan (IAM-03). Silakan perbarui kata sandi atau hubungi Admin IT TATC.</li>
        </ul>
    </div>
</div>

<script>
function amtoSwitchLoginLang(lang) {
    var enBox = document.getElementById('amtoCopyEn');
    var idBox = document.getElementById('amtoCopyId');
    var btnEn = document.getElementById('amtoBtnEn');
    var btnId = document.getElementById('amtoBtnId');
    if (lang === 'id') {
        enBox.style.display = 'none';
        idBox.style.display = 'block';
        btnId.classList.add('active');
        btnEn.classList.remove('active');
    } else {
        enBox.style.display = 'block';
        idBox.style.display = 'none';
        btnEn.classList.add('active');
        btnId.classList.remove('active');
    }
}
</script>

{{!
    @template theme_boost/navbar
    TATC Web React matched Topbar for Moodle 5.3
}}
<nav class="navbar fixed-top bg-body navbar-expand tatc-topbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn tatc-brand-link">
            <div class="tatc-brand-mark">
                <img src="/amto/assets/Logo2.png" alt="TATC" onerror="this.style.display='none'">
            </div>
            <div class="tatc-brand-copy">
                <strong>TATC Portal</strong>
                <span>LMS &amp; Certification</span>
            </div>
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/primarymoremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100 align-items-center">
            <a href="http://localhost:5173" class="btn btn-sm me-2 d-none d-lg-inline-flex align-items-center gap-1" style="background: rgba(220,38,38,0.09); color: #dc2626; font-weight: 700; font-size: 12.5px; border-radius: 999px; padding: 5px 13px; text-decoration: none; border: 1px solid rgba(220,38,38,0.2);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span>Portal Web TATC</span>
            </a>
            {{# output.search_box }}
                {{{ output.search_box }}}
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{# output.colour_mode_menu }}
                {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/ output.colour_mode_menu }}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}

{{!
    @template core/loginform
    AMTO Right Panel Login Form (CeLOE-style layout with SSO button + Manual Login)
}}
<div class="loginform amto-right-form">
    <h1 class="amto-form-title">Login to LMS</h1>
    <p class="amto-form-subtitle">Use your SSO (Microsoft) or AMTO Account</p>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
            {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    <!-- Connect with Office365 / SSO Button (matching reference UI) -->
    <button type="button" class="amto-sso-btn" onclick="var f=document.getElementById('amtoManualFormWrap'); f.style.display = (f.style.display==='none' ? 'block' : 'block'); document.getElementById('username').focus();">
        <svg width="20" height="20" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14.5 1.5L3.5 5.5V17.5L8.5 19.2V7.2L14.5 5.2V19.8L3.5 17.5L14.5 21.5L20.5 19.5V3.5L14.5 1.5Z" fill="#EA3E23"/>
        </svg>
        <span>Connect with Office365 / SSO AMTO</span>
    </button>

    <div class="amto-divider">
        <span>or sign in with AMTO credentials</span>
    </div>

    {{#showloginform}}
        <div id="amtoManualFormWrap">
            <form class="login-form" action="{{loginurl}}" method="post" id="login">
                <input id="anchor" type="hidden" name="anchor" value="">
                <script>document.getElementById('anchor').value = location.hash;</script>
                <input type="hidden" name="logintoken" value="{{logintoken}}">

                <div class="mb-3">
                    <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control amto-input"
                        value="{{username}}"
                        placeholder="Username / AMTO ID"
                        autocomplete="username"
                    >
                </div>

                <div class="mb-2">
                    <input
                        type="password"
                        name="password"
                        id="password"
                        value=""
                        class="form-control amto-input"
                        placeholder="Password"
                        autocomplete="current-password"
                    >
                </div>

                <div class="d-flex justify-content-end mb-3">
                    <a href="{{forgotpasswordurl}}" class="amto-forgot-link">Forgot password?</a>
                </div>

                <button class="btn amto-submit-btn w-100" type="submit" id="loginbtn">Log in</button>
            </form>
        </div>
    {{/showloginform}}

    <div class="amto-meta-row">
        {{#languagemenu}}
            <div class="amto-lang-dropdown">
                {{>core/action_menu}}
            </div>
        {{/languagemenu}}
        <div class="amto-cookie-btn">
            <button type="button" class="btn btn-link p-0 amto-cookie-link"
                data-modal="alert"
                data-modal-title-str='["cookiesenabled", "core"]'
                data-modal-content-str='["cookiesenabled_help_html", "core"]'
            >{{#str}}cookiesnotice{{/str}}</button>
        </div>
    </div>

    <div class="amto-no-account">
        Don't have an account yet? Contact your institution administrator.
    </div>
</div>

{{!
    @template core/loginform
    TATC Right Panel Login Form (Matched to tatcwebreact Login.jsx + CeLOE Split Layout)
}}
<div class="loginform amto-right-form">
    <div class="d-flex align-items-center gap-3 mb-3">
        <img src="/amto/assets/Logo2.png" alt="TATC" style="height: 54px; width: 54px; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.08);" onerror="this.style.display='none'">
        <div>
            <h1 class="amto-form-title mb-0">Log in to TATC LMS</h1>
            <p class="amto-form-subtitle mb-0">Use your TATC Portal or SSO Account</p>
        </div>
    </div>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
            {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    <button type="button" class="amto-sso-btn" onclick="var f=document.getElementById('amtoManualFormWrap'); f.style.display='block'; document.getElementById('username').focus();">
        <svg width="20" height="20" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14.5 1.5L3.5 5.5V17.5L8.5 19.2V7.2L14.5 5.2V19.8L3.5 17.5L14.5 21.5L20.5 19.5V3.5L14.5 1.5Z" fill="#dc2626"/>
        </svg>
        <span>Connect with TATC Portal / SSO</span>
    </button>

    <div class="amto-divider">
        <span>or sign in with LMS credentials</span>
    </div>

    {{#showloginform}}
        <div id="amtoManualFormWrap">
            <form class="login-form" action="{{loginurl}}" method="post" id="login">
                <input id="anchor" type="hidden" name="anchor" value="">
                <script>document.getElementById('anchor').value = location.hash;</script>
                <input type="hidden" name="logintoken" value="{{logintoken}}">

                <div class="mb-3">
                    <label for="username" class="tatc-field-label">Username / Email Address</label>
                    <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control amto-input"
                        value="{{username}}"
                        placeholder="Enter username or email"
                        autocomplete="username"
                    >
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="tatc-field-label mb-0">Password</label>
                        <a href="{{forgotpasswordurl}}" class="amto-forgot-link">Lupa Sandi?</a>
                    </div>
                    <input
                        type="password"
                        name="password"
                        id="password"
                        value=""
                        class="form-control amto-input"
                        placeholder="Enter password"
                        autocomplete="current-password"
                    >
                </div>

                <button class="btn amto-submit-btn w-100 mt-3" type="submit" id="loginbtn">Log In</button>
            </form>
        </div>
    {{/showloginform}}

    <div class="amto-meta-row">
        {{#languagemenu}}
            <div class="amto-lang-dropdown">
                {{>core/action_menu}}
            </div>
        {{/languagemenu}}
        <div class="amto-cookie-btn">
            <button type="button" class="btn btn-link p-0 amto-cookie-link"
                data-modal="alert"
                data-modal-title-str='["cookiesenabled", "core"]'
                data-modal-content-str='["cookiesenabled_help_html", "core"]'
            >{{#str}}cookiesnotice{{/str}}</button>
        </div>
    </div>

    <div class="amto-no-account">
        Don't have an account yet? Contact your TATC administrator.
    </div>
</div>
